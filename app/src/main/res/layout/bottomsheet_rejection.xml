<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#DBE2EF">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#B0B0B0"
        android:layout_marginBottom="20dp"/>

    <!-- Rejection Icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_delete"
        app:tint="#D3082E"/>

    <!-- Title -->
    <TextView
        android:layout_marginTop="16dp"
        android:text="Photo Rejected"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1B263B"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Message -->
    <TextView
        android:text="Please upload a clear photo with proper lighting and face visibility."
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Primary Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReupload"
        android:layout_marginTop="24dp"
        android:text="Upload New Photo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="#1B263B"
        app:cornerRadius="14dp"/>

    <!-- Secondary Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelChange"
        android:layout_marginTop="12dp"
        android:text="Not Now"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="#6B7280"
        app:cornerRadius="14dp"/>

</LinearLayout>