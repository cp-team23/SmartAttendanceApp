<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DBE2EF">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:id="@+id/headerProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1B263B"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profile Image -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/profile_temp"
                android:scaleType="centerCrop"
                android:background="@android:color/white"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                app:shapeAppearanceOverlay="@style/CircleImageView" />

            <ImageView
                android:id="@+id/tvPendingBadge"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_primary"
                android:padding="6dp"
                android:src="@drawable/bg_pending_badge"
                app:tint="@color/primary_blue"
                android:visibility="gone"
                android:contentDescription="Pending"/>

            <ImageView
                android:id="@+id/imgCameraIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_circle_primary"
                android:padding="6dp"
                android:src="@drawable/ic_menu_photo"
                app:tint="@color/primary_blue"
                android:contentDescription="Edit Photo"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvStudentId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student ID"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- ===== Info Card ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Information"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1B263B"
                android:layout_marginBottom="12dp"/>

            <!-- College -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="College"/>
                <TextView
                    android:id="@+id/tvCollege"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- Enrollment -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="Enrollment No"/>
                <TextView
                    android:id="@+id/tvEnrollment"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- College Mail -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="College Mail"/>
                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- Department -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="Department"/>
                <TextView
                    android:id="@+id/tvBranch"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- Semester -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="Semester"/>
                <TextView
                    android:id="@+id/tvSemester"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- Year -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="Year"/>
                <TextView
                    android:id="@+id/tvYear"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- Class -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="Class"/>
                <TextView
                    android:id="@+id/tvClass"
                    style="@style/profileValue"/>
            </LinearLayout>

            <View style="@style/profileDivider"/>

            <!-- Batch -->
            <LinearLayout style="@style/profileRow">
                <TextView style="@style/profileLabel" android:text="Batch"/>
                <TextView
                    android:id="@+id/tvBatch"
                    style="@style/profileValue"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- ===== Center Buttons ===== -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Change Password -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="150dp"
            android:text="Change Password"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#1B263B"
            app:cornerRadius="14dp"
            app:strokeWidth="2dp"
            app:strokeColor="#1B263B"
            app:backgroundTint="@android:color/white"
            app:elevation="0dp" />

        <!-- Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:minWidth="150dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#1B263B"
            app:cornerRadius="14dp"
            app:strokeWidth="2dp"
            app:strokeColor="#1B263B"
            app:backgroundTint="@android:color/white"
            app:elevation="0dp" />

    </LinearLayout>

    <!-- ===== Bottom Navigation ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
