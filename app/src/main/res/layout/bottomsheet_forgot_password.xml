<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#DBE2EF">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#B0B0B0"
        android:layout_marginBottom="20dp"/>

    <!-- Title -->
    <TextView
        android:text="Forgot Password"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1B263B"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Enter your Student ID or college email to receive a reset link"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etResetInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:hint="Student ID or College Email"
        android:inputType="textEmailAddress"
        android:background="@android:drawable/edit_text"/>

    <!-- Primary Action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendLink"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Send Reset Link"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:textColor="@android:color/white"
        app:backgroundTint="#1B263B"
        app:cornerRadius="14dp"/>

    <TextView
        android:id="@+id/tvResultMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginTop="16dp"/>
</LinearLayout>
